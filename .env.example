# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed — see prisma7.config.ts / lib/db.ts for how these
# are consumed.

# App runtime connection (pooled — e.g. Supabase transaction pooler on 6543,
# Neon pooled endpoint, PgBouncer, etc.)
#
# TLS: deliberately no `sslmode` param here — encryption in transit is
# enforced in code instead (see lib/db.ts's `ssl: { ca, rejectUnauthorized:
# true }` on the PrismaPg adapter). Supabase's pooler presents a certificate
# chain that Node's default trust store doesn't recognize ("self-signed
# certificate in certificate chain" — confirmed by testing, not guessed), so
# lib/db.ts reads Supabase's own downloaded CA certificate
# (certs/prod-ca-2021.crt — Dashboard -> Database -> SSL Configuration ->
# Download certificate) and verifies against it explicitly (`verify-full`
# equivalent): a certificate NOT signed by that CA is rejected outright, not
# just encrypted-and-trusted-anyway.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Direct (non-pooled) connection, used only by `prisma migrate`/`prisma db
# seed`. If your DATABASE_URL is already a direct connection (no pooler),
# DIRECT_URL can be the same value.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Signs the customer session cookie (see lib/auth/session.ts) — any long
# random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different value per environment; changing it logs everyone out.
SESSION_SECRET="REPLACE_WITH_A_RANDOM_64_CHAR_HEX_STRING"

# Signs the admin session cookie (see lib/auth/admin-session.ts) — a
# completely separate secret from SESSION_SECRET above, so the Customer and
# Admin auth boundaries can never be confused and one can be rotated without
# affecting the other. Generate the same way as SESSION_SECRET.
ADMIN_SESSION_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_64_CHAR_HEX_STRING"

# The site's public, canonical production URL (no trailing slash) — used for
# metadata's metadataBase, robots.txt, and sitemap.xml (see lib/site-config.ts).
# No production domain is deployed/registered for this project yet; leave
# unset in dev (falls back to http://localhost:3000) and set this to the real
# domain once one is chosen and deployed.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Global Image System (Product/Booking image uploads) — Supabase Storage.
# Same Supabase project as DATABASE_URL, but this is the project's REST/
# Storage base URL (Project Settings -> API -> Project URL in the Supabase
# dashboard), not the Postgres connection string.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Project Settings -> API -> service_role secret key. Server-only (see
# lib/storage.ts) — grants full read/write on Storage, so it must never reach
# client JS or be logged. Different from the anon/public key.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_YOUR_SUPABASE_SERVICE_ROLE_KEY"
# Two SEPARATE buckets, deliberately not one — see lib/storage.ts's
# "Security Correction" module comment. Create both in the Supabase dashboard
# (Storage -> New bucket) with these exact names and visibility settings, or
# override the names below to match buckets you create with different names.
#
#   speedcore-products — PUBLIC. Product photos only; served via public URL.
SUPABASE_PRODUCTS_BUCKET="speedcore-products"
#   speedcore-bookings — PRIVATE. Customer booking photos only. Do NOT mark
#   this bucket public — the app never calls getPublicUrl() on it; every read
#   goes through a server-minted, short-lived signed URL after an
#   authorization check (see lib/storage.ts / lib/account-data.ts /
#   lib/admin-data.ts).
SUPABASE_BOOKINGS_BUCKET="speedcore-bookings"
