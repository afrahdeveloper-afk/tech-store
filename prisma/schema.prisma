// Speed Core — database schema.
//
// Frontend-only mock data (lib/mock/*.ts, types/index.ts) stays in place and
// keeps powering the UI until Phase 5+ wires real queries in — see CLAUDE.md
// "Frontend Only" / "Mock Data". This schema is the real foundation those
// queries will eventually read from; nothing here is consumed by the app yet.
//
// Currency: IQD (Iraqi dinar) is the project default across Product/Order/
// Service/Booking — this targets the Iraqi market.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Product system: Category -> Subcategory -> Product -> ProductImage
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  nameAr    String?
  image     String?
  /// lucide-react export name (see lib/icon-map.ts)
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories Subcategory[]
  products      Product[]

  @@map("categories")
}

model Subcategory {
  id        String   @id @default(cuid())
  slug      String
  name      String
  nameAr    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("subcategories")
}

model Product {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  nameAr        String?
  description   String
  descriptionAr String?
  /// Short bullet-point key features/specs shown on the product details page.
  highlights    String[]      @default([])
  highlightsAr  String[]      @default([])
  price         Decimal       @db.Decimal(10, 2)
  discountPrice Decimal?      @db.Decimal(10, 2)
  currency      String        @default("IQD")
  stockQuantity Int           @default(0)
  stockStatus   StockStatus   @default(IN_STOCK)
  status        ProductStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  images     ProductImage[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  /// Supabase Storage object key (Global Image System) — needed to delete the
  /// underlying file when this row is deleted/replaced. Nullable: rows
  /// created before real uploads existed (a manually typed URL, or one of
  /// the built-in icon illustrations under public/images/products/) have no
  /// corresponding storage object to clean up.
  path      String?
  altText   String?
  altTextAr String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Service system: ServiceCategory -> Subservice -> Service
// ---------------------------------------------------------------------------

model ServiceCategory {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameAr        String?
  description   String
  descriptionAr String?
  /// lucide-react export name (see lib/icon-map.ts)
  icon          String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subservices Subservice[]

  @@map("service_categories")
}

/// Grouping node under a ServiceCategory (e.g. "Boot & Power Issues" under
/// "Laptop Maintenance"). Not bookable/priced itself — see Service.
model Subservice {
  id            String   @id @default(cuid())
  slug          String
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  serviceCategoryId String
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  services Service[]

  @@unique([serviceCategoryId, slug])
  @@index([serviceCategoryId])
  @@map("subservices")
}

/// The bookable, priced leaf (e.g. "8GB RAM Upgrade" under "RAM & SSD Upgrade").
model Service {
  id              String        @id @default(cuid())
  slug            String
  name            String
  nameAr          String?
  description     String
  descriptionAr   String?
  price           Decimal?      @db.Decimal(10, 2)
  currency        String?       @default("IQD")
  durationMinutes Int?
  image           String?
  status          ServiceStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  subserviceId String
  subservice   Subservice @relation(fields: [subserviceId], references: [id], onDelete: Restrict)

  bookings Booking[]

  @@unique([subserviceId, slug])
  @@index([subserviceId])
  @@index([status])
  @@map("services")
}

// ---------------------------------------------------------------------------
// Customer / commerce: Customer -> Order -> OrderItem -> Product
//                       Customer -> Booking -> Service
// ---------------------------------------------------------------------------

/// Customer contact/business data only — deliberately separate from
/// authentication (see CLAUDE.md "Do not create a new authentication
/// system"). `authId` is an optional, unlinked hook for whatever auth
/// provider gets wired in later; guest customers just leave it null.
model Customer {
  id           String   @id @default(cuid())
  authId       String?  @unique
  name         String
  email        String   @unique
  phone        String
  /// scrypt password hash ("salt:hash", see lib/auth/password.ts). Null for
  /// customers that only ever exist as a Checkout/Booking snapshot (guest
  /// orders/bookings) and never registered a login — see the Customer
  /// Account phase note in CLAUDE.md for why this isn't `authId`: `authId`
  /// stays reserved for a future *external* auth provider, this is the
  /// minimal first-party credential added to make that phase possible today.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders   Order[]
  bookings Booking[]

  @@map("customers")
}

// ---------------------------------------------------------------------------
// Admin: a completely separate identity/auth boundary from Customer — see
// CLAUDE.md's Phase 12 (Admin Dashboard) Security rules. Never merged with
// Customer: a Customer row is created by public self-registration and by
// anonymous Checkout/Booking upserts, which is the wrong trust surface for
// staff access. `Admin` has its own table, its own session cookie
// (`lib/auth/admin-session.ts`, `ADMIN_SESSION_SECRET`), and its own login
// route (`/admin/login`) — deliberately no public admin self-registration.
// ---------------------------------------------------------------------------

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  /// scrypt password hash ("salt:hash", reusing lib/auth/password.ts — the
  /// same hashing utility Customer uses, not a shared credential/table).
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(10, 2)
  discountTotal   Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("IQD")
  /// Flexible address snapshot (Checkout/Phase 7 isn't built yet, so no
  /// dedicated Address table until real requirements exist).
  shippingAddress Json?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  items OrderItem[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(cuid())
  /// Preserves the product name at purchase time, independent of later edits.
  productNameSnapshot String
  /// Preserves the price actually paid, independent of the current Product price.
  unitPrice           Decimal  @db.Decimal(10, 2)
  quantity            Int
  lineTotal           Decimal  @db.Decimal(10, 2)
  createdAt           DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Booking {
  id                  String        @id @default(cuid())
  bookingNumber       String        @unique
  /// Preserves the service name/price at booking time, mirroring OrderItem.
  serviceNameSnapshot String
  priceSnapshot       Decimal?      @db.Decimal(10, 2)
  status              BookingStatus @default(PENDING)
  preferredDate       DateTime?     @db.Date
  preferredTime       String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  images BookingImage[]

  @@index([customerId])
  @@index([serviceId])
  @@index([status])
  @@map("bookings")
}

/// Customer-attached photos for a Booking (Global Image System) — e.g. a
/// photo of the device or issue, uploaded while filling out the booking form
/// and attached once the Booking is created (see createBooking). Read-only
/// for Admin (view only, no admin upload); the customer who owns the
/// Booking can view them on their own Account page.
model BookingImage {
  id        String   @id @default(cuid())
  /// Deprecated as of the Security Correction (Sept 2026): booking photos now
  /// live in a PRIVATE Supabase Storage bucket, so there is no permanent
  /// public URL to store — this column is always null on rows created since.
  /// Nullable only to keep any pre-existing (public-bucket-era) row valid.
  /// Never read this for display — always derive a fresh, short-lived signed
  /// URL from `path` via `lib/storage.ts`'s `createBookingImageSignedUrl(s)`
  /// at render time, after checking the viewer is authorized (see
  /// `lib/account-data.ts`'s `getCustomerBooking` / `lib/admin-data.ts`'s
  /// `getAdminBookingById`).
  url       String?
  /// Supabase Storage object key (private `speedcore-bookings` bucket) — needed to delete the underlying file if this row is ever removed, and to mint a signed URL for display.
  path      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_images")
}

// ---------------------------------------------------------------------------
// Store-wide settings (Admin Dashboard Phase 14) — a singleton row. Added
// only after the Admin Settings page (Phase 12) shipped as an honest partial
// (admin profile only, no fake persistence) — this is the smallest schema
// that covers what CLAUDE.md's original brief listed as plausible ("Store/
// site information, Contact information, Localization/Currency, General
// configuration"). No notification/appearance preferences: nothing in this
// project has such preferences to configure yet, so none were invented.
// ---------------------------------------------------------------------------

/// Always exactly one row — see `lib/settings-data.ts`'s
/// `getOrCreateStoreSettings`, which creates it with sensible defaults on
/// first read if missing, rather than requiring a separate seed step.
model StoreSettings {
  id               String   @id @default(cuid())
  storeName        String   @default("Speed Core")
  storeNameAr      String?
  contactEmail     String   @default("support@speedcore.example")
  contactPhone     String   @default("+966 11 234 5678")
  contactAddress   String?
  contactAddressAr String?
  /// ISO 4217 currency code — matches `Product.currency`/`Order.currency`'s existing convention (a free-text default, not a DB enum).
  currency         String   @default("IQD")
  maintenanceMode  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("store_settings")
}
